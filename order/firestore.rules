rules_version = '2';

// =============================================================================
// Charroti Kitchen — Ordering App — Firestore Security Rules
//
// Principles enforced here:
//   1. A customer can only read/write their OWN profile, favorites, and cart.
//   2. A customer can only read (never modify) their OWN orders.
//   3. Order creation is allowed, but only with a consistent shape and only
//      as the authenticated user placing the order.
//   4. orderStatus and paymentStatus can NEVER be changed by the customer
//      app, on create or on update — those fields are reserved for a future
//      admin / back-office tool using the Admin SDK (which bypasses these
//      rules entirely).
//   5. The `menu` collection is public read-only from the client; only a
//      trusted back-end/admin context should ever write to it.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // USERS: users/{uid}
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // Customers may update their own profile, but never overwrite the
      // email field here — email changes must go through Firebase Auth.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // FAVORITES: users/{uid}/favorites/{dishId}
      match /favorites/{dishId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // CART: users/{uid}/cart/{dishId}
      match /cart/{dishId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------------
    // ORDERS: orders/{orderId}
    // ---------------------------------------------------------------------
// ---------------------------------------------------------------------
// ORDERS: orders/{orderId}
// ---------------------------------------------------------------------
match /orders/{orderId} {

  // Customer can read ONLY their own orders.
  allow read: if request.auth != null
              && resource.data.userId == request.auth.uid;


  // Customer can create ONLY their own order.
  //
  // Important:
  // - orderStatus must start as Pending
  // - paymentStatus must be a valid initial status
  // - paymentMethod must be COD or UPI
  // - orderId in document must match the Firestore document ID
  // - basic customer/order fields must have the expected types
  // - amount fields must be positive/non-negative numbers
  //
  allow create: if request.auth != null

                // Order belongs to the logged-in customer
                && request.resource.data.userId == request.auth.uid

                // Document ID must match stored orderId
                && request.resource.data.orderId == orderId

                // Initial order status
                && request.resource.data.orderStatus == "Pending"

                // Initial payment status
                && request.resource.data.paymentStatus
                   in ["Pending", "Awaiting Confirmation"]

                // Valid payment method
                && request.resource.data.paymentMethod
                   in ["COD", "UPI"]

                // Order must contain at least one item
                && request.resource.data.items is list
                && request.resource.data.items.size() > 0

                // Amount validation
                && request.resource.data.subtotal is number
                && request.resource.data.subtotal >= 0

                && request.resource.data.deliveryCharge is number
                && request.resource.data.deliveryCharge >= 0

                && request.resource.data.totalAmount is number
                && request.resource.data.totalAmount > 0

                // Basic customer information
                && request.resource.data.customerName is string
                && request.resource.data.email is string
                && request.resource.data.mobile is string
                && request.resource.data.address is string
                && request.resource.data.city is string

                // Payment-method/status consistency
                && (
                  (
                    request.resource.data.paymentMethod == "COD"
                    && request.resource.data.paymentStatus == "Pending"
                  )
                  ||
                  (
                    request.resource.data.paymentMethod == "UPI"
                    && request.resource.data.paymentStatus
                       == "Awaiting Confirmation"
                  )
                );


  // Customer can NEVER modify an existing order.
  //
  // Admin/back-office will handle status/payment updates later.
  allow update: if false;

  // Customer can NEVER delete an order.
  allow delete: if false;
}
    // ---------------------------------------------------------------------
    // MENU: menu/{dishId}
    // Public read-only. Only trusted back-end/admin contexts should write
    // here (e.g. via the Admin SDK, or the Firebase Console).
    // ---------------------------------------------------------------------
    match /menu/{dishId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

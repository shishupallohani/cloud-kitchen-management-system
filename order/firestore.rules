rules_version = '2';

// =============================================================================
// Charroti Kitchen — Ordering App — Firestore Security Rules
//
// Principles enforced here:
//   1. A customer can only read/write their OWN profile, favorites, and cart.
//   2. A customer can only read (never modify) their OWN orders.
//   3. Order creation is allowed, but only with a consistent shape and only
//      as the authenticated user placing the order.
//   4. orderStatus and paymentStatus can NEVER be changed by the customer
//      app, on create or on update — those fields are reserved for a future
//      admin / back-office tool using the Admin SDK (which bypasses these
//      rules entirely).
//   5. The `menu` collection is public read-only from the client; only a
//      trusted back-end/admin context should ever write to it.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // USERS: users/{uid}
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // Customers may update their own profile, but never overwrite the
      // email field here — email changes must go through Firebase Auth.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.email == resource.data.email;

      allow delete: if false;

      // FAVORITES: users/{uid}/favorites/{dishId}
      match /favorites/{dishId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // CART: users/{uid}/cart/{dishId}
      match /cart/{dishId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------------------------------------------------------------------
    // ORDERS: orders/{orderId}
    // ---------------------------------------------------------------------
    match /orders/{orderId} {
      // A customer may only read their own orders.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // A customer may create an order only for themselves, with a
      // safe/expected initial status. Payment status is allowed to be one
      // of the two values the app's own payment-service.js ever produces
      // at creation time.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.orderStatus == "Pending"
                    && request.resource.data.paymentStatus in ["Pending", "Awaiting Confirmation"]
                    && request.resource.data.items is list
                    && request.resource.data.items.size() > 0
                    && request.resource.data.totalAmount is number
                    && request.resource.data.totalAmount > 0;

      // Customers can NEVER update or delete an order once placed —
      // status changes are reserved for a future admin tool using the
      // Admin SDK, which is not subject to these rules.
      allow update: if false;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // MENU: menu/{dishId}
    // Public read-only. Only trusted back-end/admin contexts should write
    // here (e.g. via the Admin SDK, or the Firebase Console).
    // ---------------------------------------------------------------------
    match /menu/{dishId} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

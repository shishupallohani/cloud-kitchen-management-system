rules_version = '2';

/**
 * Firestore Security Rules — cloud-kitchen
 * -----------------------------------------------------------------------
 * Public visitors can only READ the data the public website needs.
 * Only signed-in, authorized admin accounts can WRITE anything.
 *
 * IMPORTANT: list the UID(s) of your admin account(s) in isAdmin() below.
 * -----------------------------------------------------------------------
 */

service cloud.firestore {

  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "8R0axsx0iedUp83VojQW6QUU8nI3"
      ];
    }

    match /dailyMenus/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customers/{mobile} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /festivalSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}